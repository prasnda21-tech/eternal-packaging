# DATABASE
MONGO_URL=mongodb://localhost:27017
DB_NAME=eternal_packaging

# AUTH
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# CORS
CORS_ORIGINS=http://localhost:3000

# ACCURATE ONLINE - SERVER SIDE ONLY
ACCURATE_API_TOKEN=
ACCURATE_DB_ID=
ACCURATE_API_SIGNATURE_SECRET=

# STORAGE
# local  = filesystem under backend/.local_storage (preview / development)
# s3     = S3-compatible / Biznet (production)
# emergent = legacy Emergent object store (production until cutover)
STORAGE_PROVIDER=s3

S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
S3_FORCE_PATH_STYLE=0

# STORAGE MIGRATION SAFETY
STORAGE_MIGRATE_LIVE=0

# APPLICATION
# Explicit runtime. Local UAT must use local|development|preview|test.
# Unset / unknown APP_ENV is fail-closed (production-style package lock).
# Production hosts must set APP_ENV=production.
APP_ENV=preview
TRIAL_DEFAULT_PASSWORD=
SEED_DEMO_ORDERS=0

# Urgent PO email (Phase B) — Gmail SMTP via App Password only.
# Keep URGENT_EMAIL_ENABLED=0 until App Password is set by account owner.
# Never commit real secrets. Never log URGENT_EMAIL_SMTP_PASSWORD.
URGENT_EMAIL_ENABLED=0
URGENT_EMAIL_SMTP_HOST=smtp.gmail.com
URGENT_EMAIL_SMTP_PORT=465
URGENT_EMAIL_SMTP_USER=eternalsabloncup@gmail.com
URGENT_EMAIL_SMTP_PASSWORD=
URGENT_EMAIL_FROM_NAME=Eternal Packaging — Notification
URGENT_EMAIL_FROM_ADDR=eternalsabloncup@gmail.com
URGENT_EMAIL_APP_BASE_URL=https://produksi.eternalpackaging.id
URGENT_EMAIL_WORKER=1
URGENT_EMAIL_WORKER_INTERVAL_SEC=15
URGENT_EMAIL_LEASE_SEC=60
URGENT_EMAIL_MAX_ATTEMPTS=8
URGENT_EMAIL_SMTP_TIMEOUT_SEC=20

# Route optimization
# Integrated optimizer was removed from the active delivery workflow.
# Historical route plans remain in Mongo. Do not call Google Route Optimization
# from this application. Google Places / Maps for Atur Lokasi is separate.

# Google Places (New) — server-side only. Never send this key to the browser.
# mock  = local fixture search (tests + preview without Google cost)
# google = official Autocomplete + Place Details
PLACES_PROVIDER=mock
GOOGLE_PLACES_API_KEY=

# Browser Maps JavaScript API key lives in frontend/.env as
# REACT_APP_GOOGLE_MAPS_BROWSER_KEY (HTTP referrer restricted).
# Do not reuse GOOGLE_PLACES_API_KEY in the browser.
