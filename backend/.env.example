# DATABASE
MONGO_URL=mongodb://localhost:27017
DB_NAME=eternal_packaging

# AUTH
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# CORS
CORS_ORIGINS=http://localhost:3000

# ACCURATE ONLINE - SERVER SIDE ONLY
ACCURATE_API_TOKEN=
ACCURATE_DB_ID=
ACCURATE_API_SIGNATURE_SECRET=

# STORAGE
# local  = filesystem under backend/.local_storage (preview / development)
# s3     = S3-compatible / Biznet (production)
# emergent = legacy Emergent object store (production until cutover)
STORAGE_PROVIDER=s3

S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
S3_FORCE_PATH_STYLE=0

# STORAGE MIGRATION SAFETY
STORAGE_MIGRATE_LIVE=0

# APPLICATION
TRIAL_DEFAULT_PASSWORD=
SEED_DEMO_ORDERS=0

# Route optimization
# mock  = deterministic local optimizer (tests + local preview)
# google = official OptimizeTours (requires project + API key)
# Production MUST NOT silently fall back to mock.
ROUTE_OPTIMIZER_PROVIDER=mock
GOOGLE_ROUTE_OPTIMIZATION_PROJECT=
GOOGLE_ROUTE_OPTIMIZATION_API_KEY=
# Optional Maps JS key for in-app review map (never call optimizer on render)
# GOOGLE_MAPS_API_KEY=

# Google Places (New) — server-side only. Never send this key to the browser.
# mock  = local fixture search (tests + preview without Google cost)
# google = official Autocomplete + Place Details
PLACES_PROVIDER=mock
GOOGLE_PLACES_API_KEY=

# Browser Maps JavaScript API key lives in frontend/.env as
# REACT_APP_GOOGLE_MAPS_BROWSER_KEY (HTTP referrer restricted).
# Do not reuse GOOGLE_PLACES_API_KEY or GOOGLE_ROUTE_OPTIMIZATION_API_KEY in the browser.