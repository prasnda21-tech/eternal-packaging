[Unit]
Description=Eternal Packaging backend (release symlink)
After=network.target mongod.service
Wants=network.target

[Service]
Type=simple
User=eternaladmin
Group=eternaladmin
# Active code always comes from the isolated release symlink under the dedicated runtime root.
WorkingDirectory=/opt/eternal-packaging-runtime/current/backend
# Keep existing environment files (do not copy secrets into releases).
EnvironmentFile=-/opt/eternal-packaging/backend/.env
EnvironmentFile=-/etc/eternal-packaging-google-places.env
ExecStart=/opt/eternal-packaging-runtime/current/backend/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
# Least privilege: no NewPrivileges escalation; Owner may tighten further.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
