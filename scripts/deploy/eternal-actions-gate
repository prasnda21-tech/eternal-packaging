#!/usr/bin/env bash
# SSH forced-command gate for Eternal Packaging GitHub Actions deploy key.
#
# Install via scripts/deploy/install-gate.sh (verified before activation).
# authorized_keys example:
#   restrict,command="/home/deploy/.ssh/eternal-actions-gate" ssh-ed25519 AAAA... eternal-gha-deploy
#
# Accepts ONLY:
#   probe
#   deploy <40-char-lowercase-sha>
#   deploy <40-char-lowercase-sha> ack-fe-replace
#   rollback <40-char-lowercase-sha> <previous_id>
#     previous_id = 40-char-lowercase-sha | baseline-active
#
# Rejects arbitrary shell, paths, scp/sftp, and any other command.
# Does not read or print private keys. Does not invoke sudo.

set -euo pipefail

GATE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$GATE_DIR/lib.sh"

RUNNER="${ETERNAL_DEPLOY_RUNNER:-$GATE_DIR/eternal-deploy-runner.sh}"

raw="${SSH_ORIGINAL_COMMAND-}"
cmd="$(printf '%s' "$raw" | tr -d '\r' | tr '\n' ' ')"
cmd="$(printf '%s' "$cmd" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

if [[ -z "$cmd" ]]; then
  eternal_deploy_die "empty SSH command rejected"
fi

case "$cmd" in
  *';'*|*'&'*|*'|'*|*'`'*|*$'('*|*')'*|*'<'*|*'>'*|*'$'*|*'\\'*)
    eternal_deploy_die "metacharacters rejected"
    ;;
  *../*|*/..*|~/*)
    eternal_deploy_die "path traversal rejected"
    ;;
esac

# shellcheck disable=SC2086
set -- $cmd
verb="${1:-}"
arg="${2:-}"
opt="${3:-}"
extra="${4:-}"

if [[ -n "$extra" ]]; then
  eternal_deploy_die "too many arguments"
fi

case "$verb" in
  probe)
    if [[ -n "$arg" || -n "$opt" ]]; then
      eternal_deploy_die "probe takes no arguments"
    fi
    eternal_print_probe_ok
    exit 0
    ;;
  deploy)
    eternal_require_sha40 "$arg"
    if [[ -n "$opt" && "$opt" != "ack-fe-replace" ]]; then
      eternal_deploy_die "unsupported deploy option (allowed optional: ack-fe-replace)"
    fi
    if [[ "$opt" == "ack-fe-replace" ]]; then
      export ETERNAL_ACK_REPLACE_LIVE_FRONTEND=1
    fi
    if [[ ! -x "$RUNNER" ]]; then
      eternal_deploy_die "deploy runner missing or not executable: $RUNNER"
    fi
    exec "$RUNNER" deploy "$arg"
    ;;
  rollback)
    eternal_require_sha40 "$arg"
    eternal_require_previous_id "$opt"
    if [[ ! -x "$RUNNER" ]]; then
      eternal_deploy_die "deploy runner missing or not executable: $RUNNER"
    fi
    exec "$RUNNER" rollback "$arg" "$opt"
    ;;
  *)
    eternal_deploy_die "unsupported command (allowed: probe | deploy <sha40> [ack-fe-replace] | rollback <sha40> <previous_id>)"
    ;;
esac
