{
  "expo": {
    "name": "Eternal Packaging",
    "slug": "eternal-packaging-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "eternal",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eternalpackaging.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Eternal membutuhkan kamera untuk sampel cetak dan bukti pengiriman.",
        "NSPhotoLibraryUsageDescription": "Eternal membutuhkan akses foto untuk sampel cetak dan bukti pengiriman.",
        "NSPhotoLibraryAddUsageDescription": "Eternal membutuhkan akses foto untuk sampel cetak dan bukti pengiriman."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.eternalpackaging.mobile",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Eternal membutuhkan akses foto untuk sampel cetak dan bukti pengiriman.",
          "cameraPermission": "Eternal membutuhkan kamera untuk sampel cetak dan bukti pengiriman."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
